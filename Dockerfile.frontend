FROM python:3.11-slim

WORKDIR /app

RUN pip install --index-url https://pypi.org/simple/ \
    --default-timeout=1000 --retries 10 --no-cache-dir streamlit httpx \
    || pip install --index-url https://pypi.org/simple/ \
    --default-timeout=2000 --retries 10 --no-cache-dir streamlit httpx

COPY frontend/ frontend/

EXPOSE 8501

HEALTHCHECK --interval=10s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8501/api/v1/metadata || exit 1

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
